#Something custom/made by me(lwss).
#Include this in your CMakeLists.txt to set the various platform defines the codebase expects
if(WIN32)
    message(FATAL_ERROR "install gentoo")
elseif(UNIX AND NOT APPLE)
    message(FATAL_ERROR "Linux is not supported: this source tree builds only for macOS on Apple Silicon.")
elseif(UNIX AND APPLE)
    add_definitions(-DPOSIX -D_POSIX -DOSX -D_OSX)
    set(OSXALL "1")
    set(POSIX "1")
    set(GL "1")
    # Valve's macOS loader uses conventional .dylib module names (engine.dylib,
    # client.dylib, and so on).
    set(_DLL_EXT ".dylib")
    set(OUTDLLEXT ".dylib")
    if(CMAKE_SIZEOF_VOID_P EQUAL 8)
        add_definitions(-DOSX64 -DPLATFORM_64BITS)
        set(OSX64 "1")
    elseif(CMAKE_SIZEOF_VOID_P EQUAL 4)
        add_definitions(-DOSX32)
        set(OSX32 "1")
    else()
        message(FATAL_ERROR "Weird pointer size! Couldn't detect x64/x86")
    endif()
else()
    message(FATAL_ERROR "platform undetected!")
endif()
